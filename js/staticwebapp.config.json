{
  "routes": [
    {
      "route": "/medewerker.html",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/mijn-planning",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/melding",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/berichten",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/medewerker.html", "/api/*", "/css/*", "/js/*"]
  }
}
